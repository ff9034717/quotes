        // Render 20 Personalities on Grid
        const gridEl = document.getElementById('personalities-grid');
        
        database.forEach(item => {
            const card = document.createElement('div');
            card.className = 'personality-card';
            card.innerHTML = `
                <img src="${item.img}" alt="${item.name}" class="personality-img">
                <div class="personality-info">
                    <div class="personality-name">${item.name}</div>
                    <div class="personality-tag">${item.tag}</div>
                </div>
            `;
            card.addEventListener('click', () => showDetail(item.id));
            gridEl.appendChild(card);
        });

        // Show Detail View
        function showDetail(id) {
            const person = database.find(p => p.id === id);
            if (!person) return;

            document.getElementById('main-grid-section').style.display = 'none';
            const detailView = document.getElementById('detail-view');
            detailView.style.display = 'block';

            let quotesHTML = '';
            person.quotes.forEach((q, index) => {
                const whatsappText = encodeURIComponent(`${person.name} کا قول:\n\n"${q}"\n\n(مزید اقوال کے لیے ہماری ویب سائٹ ملاحظہ کریں)`);
                quotesHTML += `
                    <div class="quote-item">
                        <div><strong>قول نمبر ${index + 1}:</strong> "${q}"</div>
                        <a href="https://wa.me/?text=${whatsappText}" class="whatsapp-btn" target="_blank">واٹس ایپ پر شیئر کریں 🟢</a>
                    </div>
                `;
            });

            document.getElementById('detail-content').innerHTML = `
                <div class="detail-header">
                    <img src="${person.img}" alt="${person.name}" class="detail-img">
                    <div class="detail-bio">
                        <h2>${person.name}</h2>
                        <p style="color:#38bdf8; font-size:14px; margin-bottom:8px;">${person.tag}</p>
                        <p>${person.bio}</p>
                    </div>
                </div>
                <h3 style="color:#fbbf24; margin-bottom:15px; border-bottom:1px solid #334155; padding-bottom:8px;">مخصوص 5 اقوالِ زریں</h3>
                <div class="quotes-list">
                    ${quotesHTML}
                </div>
            `;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Go Back to Grid View
        function goBack() {
            document.getElementById('detail-view').style.display = 'none';
            document.getElementById('main-grid-section').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
